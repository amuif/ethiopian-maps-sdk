{
  "name": "ethiopian-maps-expo-demo",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build:sdk": "pnpm --filter \"@ethiopiamaps/react-native...\" build",
    "android": "pnpm build:sdk && expo run:android",
    "ios": "pnpm build:sdk && expo run:ios",
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ethiopiamaps/react-native": "workspace:*",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "expo": "~58.0.26",
    "expo-dev-client": "~58.0.21",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.4.5"
  }
}
