{
  "version": 8,
  "name": "Ethiopia Bilingual (Amharic-English)",
  "metadata": {
    "author": "amuif (Ibrahim)",
    "description": "Bilingual vector map style for Ethiopia prioritizing Ge'ez typography and national transit corridors",
    "maputnik:renderer": "mbgljs"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://{PMTILES_URL}"
    }
  },
  "glyphs": "{BASE_URL}/glyphs/{fontstack}/{range}.pbf",
  "sprite": "{BASE_URL}/sprites/sprite",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f8f9fa"
      }
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": {
        "fill-color": "#e9ecef",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#bfe3f7"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#8ecae6",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 14, 3]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": {
        "line-color": "#495057",
        "line-width": 2,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "boundary-region",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 4],
      "paint": {
        "line-color": "#6c757d",
        "line-width": 1.5,
        "line-dasharray": [4, 3]
      }
    },
    {
      "id": "boundary-zone-woreda",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 9,
      "filter": ["in", "admin_level", 6, 8],
      "paint": {
        "line-color": "#adb5bd",
        "line-width": 1,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#dee2e6",
        "fill-outline-color": "#ced4da"
      }
    },
    {
      "id": "tunnel-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "brunnel", "tunnel"],
      "paint": {
        "line-color": "#ced4da",
        "line-dasharray": [2, 2],
        "line-width": 2
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": ["in", "class", "minor", "service", "track"],
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 16, 4]
      }
    },
    {
      "id": "road-secondary-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": {
        "line-color": "#ffeaa7",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 1.5, 16, 6]
      }
    },
    {
      "id": "road-trunk-primary-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "paint": {
        "line-color": "#d63031",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 2, 14, 8]
      }
    },
    {
      "id": "road-trunk-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk", "primary"],
      "paint": {
        "line-color": "#ff7675",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 1.5, 14, 6]
      }
    },
    {
      "id": "building-3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 15,
      "filter": ["!=", ["get", "hide_3d"], true],
      "paint": {
        "fill-extrusion-color": "#d5d9de",
        "fill-extrusion-height": ["interpolate", ["linear"], ["zoom"], 15, 0, 16, ["coalesce", ["get", "render_height"], 5]],
        "fill-extrusion-base": ["interpolate", ["linear"], ["zoom"], 15, 0, 16, ["coalesce", ["get", "render_min_height"], 0]],
        "fill-extrusion-opacity": 0.85
      }
    },
    {
      "id": "poi-icons",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "layout": {
        "icon-image": [
          "match",
          ["get", "class"],
          "place_of_worship", "poi-church",
          "hospital", "poi-hospital",
          "bus", "transit-bus-intercity",
          "marker-15"
        ],
        "icon-size": 0.8,
        "icon-allow-overlap": false
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Ethiopic Bold", "Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 10, 16, 16, 20],
        "text-anchor": "bottom",
        "text-padding": 4,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#212529",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-labels-amharic",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 13,
      "filter": [
        "all",
        ["has", "name:am"],
        ["!=", ["get", "name:am"], ["coalesce", ["get", "name:en"], ["get", "name:latin"], ""]]
      ],
      "layout": {
        "text-field": ["get", "name:am"],
        "text-font": ["Noto Sans Ethiopic Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 9, 16, 13],
        "text-anchor": "top",
        "text-optional": true,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#495057",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.0
      }
    },
    {
      "id": "road-name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name:latin"], ["get", "name"]],
        "text-font": ["Noto Sans Ethiopic Regular", "Noto Sans Regular"],
        "text-size": 11,
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "#212529",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.5
      }
    }
  ]
}
